From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Euphyllia Bierque <bierque.euphyllia@gmail.com>
Date: Sun, 11 Oct 2026 08:15:54 +0200
Subject: [PATCH] Fix teleport safety checks reading blocks off region


diff --git a/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java b/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
index a010b7dde3d0395e1ffadff6201f75a030b0f853..688e6413d7281705aedbe3da504acf2076ffe378 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/AsyncTeleport.java
@@ -134,7 +134,7 @@ public class AsyncTeleport implements IAsyncTeleport {
     }
 
     @Override
-    public void nowUnsafe(Location loc, TeleportCause cause, CompletableFuture<Boolean> future) {
+    public void nowUnsafe(final Location loc, final TeleportCause cause, final CompletableFuture<Boolean> future) {
         final CompletableFuture<Boolean> paperFuture = teleportOwner.getBase().teleportAsync(loc, cause);
         paperFuture.thenAccept(future::complete);
         paperFuture.exceptionally(future::completeExceptionally);
@@ -187,7 +187,7 @@ public class AsyncTeleport implements IAsyncTeleport {
             targetLoc.setX(LocationUtil.getXInsideWorldBorder(targetLoc.getWorld(), targetLoc.getBlockX()));
             targetLoc.setZ(LocationUtil.getZInsideWorldBorder(targetLoc.getWorld(), targetLoc.getBlockZ()));
         }
-        targetLoc.getWorld().getChunkAtAsync(targetLoc.getBlockX() >> 4, targetLoc.getBlockZ() >> 4, true, true).thenAccept(chunk -> {
+        targetLoc.getWorld().getChunkAtAsync(targetLoc.getBlockX() >> 4, targetLoc.getBlockZ() >> 4, true, true).thenAccept(chunk -> runOnRegion(targetLoc, future, () -> {
             Location loc = targetLoc;
             if (LocationUtil.isBlockUnsafeForUser(ess, teleportee, chunk.getWorld(), loc.getBlockX(), loc.getBlockY(), loc.getBlockZ())) {
                 if (ess.getSettings().isTeleportSafetyEnabled()) {
@@ -220,12 +220,22 @@ public class AsyncTeleport implements IAsyncTeleport {
                 }
             }
             future.complete(true);
-        }).exceptionally(th -> {
+        })).exceptionally(th -> {
             future.completeExceptionally(th);
             return null;
         });
     }
 
+    private void runOnRegion(final Location location, final CompletableFuture<Boolean> future, final Runnable runnable) {
+        ess.getRegionScheduler().execute(ess, location, () -> {
+            try {
+                runnable.run();
+            } catch (final Throwable th) {
+                future.completeExceptionally(th);
+            }
+        });
+    }
+
     @Override
     public void teleport(final Location loc, final Trade chargeFor, final TeleportCause cause, final CompletableFuture<Boolean> future) {
         teleport(teleportOwner, new LocationTarget(loc), chargeFor, cause, future);
@@ -396,7 +406,7 @@ public class AsyncTeleport implements IAsyncTeleport {
 
     void respawnNow(final IUser teleportee, final TeleportCause cause, final CompletableFuture<Boolean> future) {
         final Player player = teleportee.getBase();
-        Location bedLocation = teleportee.getRespawnLocationCompat();
+        final Location bedLocation = teleportee.getRespawnLocationCompat();
         if (bedLocation == null || bedLocation.getWorld() == null) {
             return;
         }
@@ -479,7 +489,7 @@ public class AsyncTeleport implements IAsyncTeleport {
         }
     }
 
-    private void initTimer(final long delay, final IUser teleportUser, final ITarget target, final Trade chargeFor, final TeleportCause cause, final boolean respawn, CompletableFuture<Boolean> future) {
+    private void initTimer(final long delay, final IUser teleportUser, final ITarget target, final Trade chargeFor, final TeleportCause cause, final boolean respawn, final CompletableFuture<Boolean> future) {
         timedTeleport = new AsyncTimedTeleport(teleportOwner, ess, this, delay, future, teleportUser, target, chargeFor, cause, respawn);
     }
 
