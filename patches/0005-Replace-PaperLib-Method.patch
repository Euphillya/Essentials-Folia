diff --git a/Essentials/src/main/java/net/ess3/api/IUser.java b/Essentials/src/main/java/net/ess3/api/IUser.java
index 7911b71037329121575586891ede9be6cb861021..ff9a7327ebe8dab0770b437f70ea4ed30495a20a 100644
--- a/Essentials/src/main/java/net/ess3/api/IUser.java
+++ b/Essentials/src/main/java/net/ess3/api/IUser.java
@@ -1,5 +1,8 @@
 package net.ess3.api;
 
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+
 /**
  * This interface may contain future additions to the warps API on top of {@link com.earth2me.essentials.IUser}.
  *
@@ -7,4 +10,19 @@ package net.ess3.api;
  */
 public interface IUser extends com.earth2me.essentials.IUser {
 
+    /**
+     * Returns the respawn location of the player (bed or respawn anchor).
+     * Compatible with all server versions: uses {@code getRespawnLocation(boolean)} on 1.21.11+,
+     * falls back to {@code getRespawnLocation()} on older versions.
+     *
+     * @return the respawn location, or {@code null} if none is set
+     */
+    default Location getRespawnLocationCompat() {
+        final Player player = getBase();
+        try {
+            return player.getRespawnLocation(false);
+        } catch (NoSuchMethodError ignored) {
+            return player.getRespawnLocation();
+        }
+    }
 }
