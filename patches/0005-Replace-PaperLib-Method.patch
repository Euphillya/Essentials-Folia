@@ -113,7 +119,13 @@ public class Commandhome extends EssentialsCommand {
                 message.complete(null);
                 return;
             }
-            PaperLib.getBedSpawnLocationAsync(player.getBase(), true).thenAccept(message::complete);
+            final Location bedLocation = player.getRespawnLocationCompat();
