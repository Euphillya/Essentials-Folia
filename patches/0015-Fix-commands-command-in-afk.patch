Subject: [PATCH] Fix commands command in afk


diff --git a/Essentials/src/main/java/com/earth2me/essentials/User.java b/Essentials/src/main/java/com/earth2me/essentials/User.java
index 24dc698bd75e2727d550249c2c13958699b71413..cd44d4f56c7f67affa1b1211f70659809c084a17 100644
--- a/Essentials/src/main/java/com/earth2me/essentials/User.java
+++ b/Essentials/src/main/java/com/earth2me/essentials/User.java
@@ -911,6 +911,7 @@ public class User extends UserData implements Comparable<User>, IMessageRecipien
                 }
             } else {
                 // If `afk-timeout-commands` in config.yml is populated, execute the command(s) instead of kicking the player.
+                ess.getGlobalRegionScheduler().execute(ess, () -> {
                 for (final String command : ess.getSettings().getAfkTimeoutCommands()) {
                     if (command == null || command.isEmpty()){
                         continue;
@@ -918,7 +919,7 @@ public class User extends UserData implements Comparable<User>, IMessageRecipien
                     // Replace placeholders in the command with actual values.
                     final String cmd = command.replace("{USERNAME}", getName()).replace("{KICKTIME}", String.valueOf(kickTime));
                     ess.getServer().dispatchCommand(ess.getServer().getConsoleSender(), cmd);
-                }
+                }});
             }
         }
         final long autoafk = ess.getSettings().getAutoAfk();
